# ─── JalanGo API server ────────────────────────────────────────────────
# These values stay on the server. Never prefix them with VITE_.

PORT=8787
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Mapbox token used for Geocoding + Directions. A secret (sk.*) or a
# URL-restricted public (pk.*) token both work. Leave empty → demo mode.
MAPBOX_ACCESS_TOKEN=

# Supabase (used from Phase 3 for validated report writes / anti-spam).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
