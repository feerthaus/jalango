# ─── JalanGo API server ────────────────────────────────────────────────
# These values stay on the server. Never prefix them with VITE_.

PORT=8787
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Mapbox token used for Geocoding + Directions. A secret (sk.*) or a
# URL-restricted public (pk.*) token both work. Leave empty → demo mode.
MAPBOX_ACCESS_TOKEN=

# Supabase (used from Phase 3 for validated report writes / anti-spam).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Anthropic): smart search (Haiku) and the trip assistant (Sonnet).
# Leave empty → both are off and search works as before.
ANTHROPIC_API_KEY=
# Trip assistant questions per signed-in user per day (default 20)
ASSISTANT_DAILY_LIMIT=

# POI import from GitHub Actions (POI-2B). Off unless POI_IMPORT_ENABLED=true.
# The token (32+ random characters) must match the POI_INGEST_TOKEN secret of the
# "POI import (Kuala Langat)" workflow. It is NOT the Supabase service-role key.
POI_IMPORT_ENABLED=
POI_INGEST_TOKEN=
# POI-3: JalanGo's own POIs (OpenStreetMap, Kuala Langat) in search, next to Mapbox.
# Off unless set to true. Needs the search_pois database function (migration 20261204000000).
POI_SEARCH_ENABLED=
