# ─── JalanGo web client ────────────────────────────────────────────────
# Everything prefixed with VITE_ is bundled into the browser.
# Only put PUBLIC, URL-restricted keys here — never secret keys.

# Mapbox PUBLIC token (pk.*) used to render map tiles. Restrict it to your
# domains in the Mapbox dashboard. Leave empty → demo basemap.
VITE_MAPBOX_PUBLIC_TOKEN=

# Base URL of the JalanGo API server. Leave empty to use same-origin /api
# (the Vite dev server proxies /api → http://localhost:8787).
VITE_API_BASE_URL=

# Supabase project (anon key is public by design; data is protected by RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
